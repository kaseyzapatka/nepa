# Local data
NEPA_RAG_DATA_DIR=rag/data
NEPA_RAG_CATALOG=rag/data/rag_catalog.duckdb
NEPA_RAG_MANIFEST=rag/data/manifest.json

# Hugging Face dataset repo for RAG artifacts
NEPA_RAG_DB_HF_REPO=YOUR_HF_USERNAME/nepa-rag-db
NEPA_RAG_DB_HF_REVISION=main

# LLM provider
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:e2b
LLM_QUALITY_MODEL=gemma4:e4b
LLM_FALLBACK_MODEL=gemma4:e2b
OLLAMA_HOST=http://localhost:11434
LLM_TIMEOUT_SECONDS=120
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=350

# Retrieval
RAG_TOP_K_PER_SHARD=3
RAG_MAX_CONTEXT_PASSAGES=4
RAG_MAX_CONTEXT_TOKENS=2500
RAG_REQUIRE_SOURCE_LABELS=true

# App behavior
RAG_SESSION_HISTORY_ONLY=true
RAG_DEFAULT_SCOPE=selected_project
